# Виртуальное окружение
venv/
.venv/

# Кэш Python
__pycache__/
*.pyc
*.py[cod]
*$py.class

# Переменные окружения (секреты!)
.env
.env.*
# ...кроме шаблона без секретов — его как раз нужно держать в репозитории.
!.env.example

# Сгенерированные картинки-сцены: это кеш, он восстанавливается генерацией.
media/

# AST-кеш graphify: ~2 МБ производных данных, пересчитывается бесплатно
# командой `graphify update .`. Семантический кеш (cache/semantic/) НЕ
# игнорируем — он получен платной экстракцией и весит копейки.
graphify-out/cache/ast/
# Датированные бэкапы графа, которые graphify делает при каждом обновлении:
# сам граф лежит рядом и отслеживается, копии в истории не нужны.
graphify-out/20*/

# Системные файлы
.DS_Store

*.log

# База данных
*.db
*.sqlite
*.sqlite3