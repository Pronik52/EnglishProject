# Подключение к БД (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/english

# JWT
SECRET_KEY=change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie авторизации: false только для локального HTTP; на production — true.
COOKIE_SECURE=false

# Нужен лишь когда frontend запускается на отдельном origin. Несколько адресов
# разделяются запятыми. Для встроенного /app оставьте пустым.
CORS_ALLOW_ORIGINS=

# --- Лимиты (защита от злоупотреблений, не тариф) ---
# Каждое слово и каждая проверка описания — вызов внешнего API за деньги, а
# открытая ручка без потолка выносится одним скриптом. Значения по умолчанию
# подобраны так, чтобы обычный человек их не замечал; менять обычно не нужно.
DAILY_WORD_LIMIT=50
DAILY_DESCRIBE_LIMIT=50
REGEN_LIMIT=10

# Демо-покупка Premium (POST /billing/activate|deactivate). Оплата фиктивная,
# карта никуда не уходит, поэтому в бою флаг должен быть выключен: иначе любой
# авторизованный пользователь включает себе Premium одним запросом.
# Кнопки в интерфейсе нет — оплата вернётся с настоящим провайдером.
BILLING_DEMO_ENABLED=false

# Groq API для ИИ-генерации фраз (необязательно: без ключа используется оффлайн-фолбэк)
# Ключ берётся на https://console.groq.com — бесплатный тариф без карты.
GROQ_API_KEY=

# --- Картинки-сцены к фразам ---
# Провайдер генерации: pollinations | cloudflare | off
#   pollinations — без ключа и без регистрации, но не больше одного запроса
#                  примерно раз в 15 секунд. Годится для разработки.
#   cloudflare   — Workers AI, модель FLUX-1-schnell. Бесплатная суточная
#                  квота, аккаунт нужен, карта — нет. Вариант для боя.
#   off          — картинки не генерируются вовсе.
IMAGE_PROVIDER=pollinations

# Необязательный токен Pollinations: поднимает лимит частоты и убирает
# водяной знак. Регистрация бесплатная.
POLLINATIONS_TOKEN=

# Нужны только при IMAGE_PROVIDER=cloudflare.
# ACCOUNT_ID виден в адресной строке панели Cloudflare, токен создаётся в
# My Profile → API Tokens с правом Workers AI: Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Сторона картинки в пикселях и таймаут запроса к провайдеру в секундах.
IMAGE_SIZE=768
IMAGE_TIMEOUT=90
